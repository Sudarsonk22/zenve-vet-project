VITE_API_BASE_URL=http://localhost:8080/api
# Where the existing login page lives (used when the backend answers 401)
VITE_LOGIN_ROUTE=/login
# localStorage key under which your existing login stores the JWT
VITE_AUTH_TOKEN_KEY=token
# Client-side upload limits (MB) - keep in sync with spring.servlet.multipart.max-file-size
VITE_MAX_VIDEO_MB=200
VITE_MAX_ATTACHMENT_MB=10
